      {
        "letter": "B",
        "text": "Build a cloud IaaS and perform a fail over of the application.",
        "is_correct": false
      },
      {
        "letter": "C",
        "text": "Build a hot site and perform a fail over of the application.",
        "is_correct": false
      },
      {
        "letter": "D",
        "text": "Build a cold site and perform a fail over of the application.",
        "is_correct": false
      },
      {
        "letter": "E",
        "text": "Perform a tabletop fail over of the application.",
        "is_correct": true
      }
    ],
    "suggested_answers": [
