        "letter": "C",
        "text": "FCoE",
        "is_correct": false
      },
      {
        "letter": "D",
        "text": "NFS",
        "is_correct": true
      }
    ],
    "suggested_answers": [
      "D"
    ],
    "answers": [
      "(D) Network File System is the only file-based storage protocol listed."
