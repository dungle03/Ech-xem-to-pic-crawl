  {
    "exam_code": "sk0-005",
    "topic": 1,
    "question_num": 45,
    "question": "Which of the following should an administrator use to transfer log files from a Linux server to a Windows workstation?",
    "options": [
      {
        "letter": "A",
        "text": "Telnet",
        "is_correct": false
