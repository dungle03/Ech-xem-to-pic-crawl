        "is_correct": false
      },
      {
        "letter": "B",
        "text": "Per core",
        "is_correct": true
      },
      {
        "letter": "C",
        "text": "Per instance",
        "is_correct": false
      },
      {
        "letter": "D",
        "text": "Per concurrent user",
        "is_correct": false
      }
    ],
    "suggested_answers": [
      "B"
