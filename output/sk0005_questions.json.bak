  {
    "exam_code": "sk0-005",
    "topic": 1,
    "question_num": 342,
    "question": "Which of the following symbols is used to write a text description per line within a PowerShell script?",
    "options": [
      {
        "letter": "A",
        "text": "%",
        "is_correct": false
      },
      {
        "letter": "B",
        "text": "@",
        "is_correct": false
      },
      {
        "letter": "C",
        "text": "&",
        "is_correct": false
      },
      {
        "letter": "D",
        "text": "#",
        "is_correct": true
      }
    ],
    "suggested_answers": [
      "D"
    ],
    "answers": [
      "D. # (hash symbol)\n\nIn PowerShell scripts, the hash symbol (#) is used to write comments or text descriptions per line. Comments are ignored by PowerShell and are useful for adding explanations or annotations within the script."
    ],
    "url": "https://www.examtopics.com/discussions/comptia/view/135939-exam-sk0-005-topic-1-question-342-discussion/"
  },
