      },
      {
        "letter": "B",
        "text": "Place the existing data on a DVD and use the internal DVD-ROM drive.",
        "is_correct": false
      },
      {
        "letter": "C",
        "text": "Transfer the existing data to an external eSATA enclosure.",
        "is_correct": true
      },
      {
        "letter": "D",
        "text": "Move the existing data to a new, larger internal hard drive.",
        "is_correct": false
      }
    ],
    "suggested_answers": [
      "C"
    ],
    "answers": [
      "C. Transfer the existing data to an external eSATA enclosure."
