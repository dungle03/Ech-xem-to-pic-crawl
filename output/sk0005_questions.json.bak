  {
    "exam_code": "sk0-005",
    "topic": 1,
    "question_num": 154,
    "question": "Which of the following BEST describes the metric that is used to measure server downtime?",
    "options": [
      {
        "letter": "A",
        "text": "MTTR",
        "is_correct": true
      },
      {
        "letter": "B",
        "text": "BIA",
        "is_correct": false
      },
      {
        "letter": "C",
        "text": "RPO",
        "is_correct": false
      },
      {
        "letter": "D",
        "text": "SLA",
        "is_correct": false
      }
    ],
    "suggested_answers": [
      "A"
    ],
    "answers": [
      "MTTR represents the average time it takes to fix an issue once it has been identified.\nIt measures how quickly a system, node, or service can be restored back to normal operation.",
      "MTTR Mean Time To Recovery"
    ],
