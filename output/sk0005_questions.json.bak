  {
    "exam_code": "sk0-005",
    "topic": 1,
    "question_num": 349,
    "question": "Which of the following security risks provides unauthorized access to an application?",
    "options": [
      {
        "letter": "A",
        "text": "Backdoor",
        "is_correct": true
      },
      {
        "letter": "B",
        "text": "Data corruption",
