  {
    "exam_code": "sk0-005",
    "topic": 1,
    "question_num": 257,
    "question": "A technician has received tickets reporting a server is responding slowly during business hours. Which of the following should the technician implement so the team will be informed of this behavior in real time?",
    "options": [
      {
        "letter": "A",
