  {
    "exam_code": "sk0-005",
    "topic": 1,
    "question_num": 176,
    "question": "Which of the following is a system that scans outgoing email for account numbers, sensitive phrases, and other forms of PII?",
    "options": [
      {
        "letter": "A",
        "text": "SIEM",
        "is_correct": false
      },
      {
        "letter": "B",
        "text": "DLP",
        "is_correct": true
      },
