  {
    "exam_code": "sk0-005",
    "topic": 1,
    "question_num": 231,
    "question": "An administrator is designing a server for use in a factory environment that contains many pieces of large electrical equipment. Which of the following would be the BEST type of cable for the administrator to use to minimize networking issues?",
    "options": [
