      },
      {
        "letter": "B",
        "text": "Higher-capacity PDUs",
        "is_correct": false
      },
      {
        "letter": "C",
        "text": "Rail kits",
        "is_correct": false
      },
      {
        "letter": "D",
        "text": "Blanking panels",
        "is_correct": true
      }
    ],
    "suggested_answers": [
      "D"
    ],
    "answers": [],
    "url": "https://www.examtopics.com/discussions/comptia/view/336915-exam-sk0-005-topic-1-question-441-discussion/"
  },
