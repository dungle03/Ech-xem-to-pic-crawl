  {
    "exam_code": "sk0-005",
    "topic": 1,
    "question_num": 438,
    "question": "Which of the following licensing models allows the greatest number of concurrent Windows VMs to run on a host for the lowest cost?",
    "options": [
      {
        "letter": "A",
